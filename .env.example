DATABASE_URL=postgresql://setu:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/setu?schema=public
# Optional direct (unpooled) URL for migrations; Neon's Vercel integration sets it automatically.
# DATABASE_URL_UNPOOLED=
APP_URL=http://127.0.0.1:3000
# Required only when seeding; choose a unique development password (12+ characters).
SEED_PASSWORD=
# Development only: mail is written under .local/mail for terminal inspection.
DEV_MAIL=true
# Optional: dedicated test database; name must end in _test.
# TEST_DATABASE_URL=postgresql://setu:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/setu_test?schema=public
# Only enable behind an ingress that strips/replaces X-Forwarded-For.
# TRUST_PROXY=true
# Production requires Resend and HTTPS APP_URL. MAIL_FROM must use a domain verified in Resend,
# e.g. "Setu Workflow <noreply@yourdomain.com>".
RESEND_API_KEY=
MAIL_FROM=
# Production (Vercel): random 16+ character secret authorizing the daily cleanup cron.
CRON_SECRET=

# Optional override for the trial continuation contact.
TRIAL_CONTACT_EMAIL=hello@setutechnology.com


# Setu Workflow license keys (sold on setutechnology.com, redeemed in Admin → Subscription).
# Must equal WORKFLOW_LICENSE_SECRET on the Setu website. Required in production to redeem keys;
# changing it invalidates every key sold but not yet redeemed. Generate with: openssl rand -hex 32
WORKFLOW_LICENSE_SECRET=
# Optional: where "Buy a key" links go (defaults to https://setutechnology.com/products/workflow).
# NEXT_PUBLIC_WORKFLOW_BUY_URL=

# Setu owner console ("super admin" for Setu staff). Off unless set. The console lives at
# /console/<PLATFORM_ROUTE_SECRET>; every other path 404s. Use 16+ random characters
# (openssl rand -hex 16) and keep it private. Bootstrap the first staff member with:
#   pnpm console:admin create you@setutechnology.com "Your Name"   (prints a set-password link)
PLATFORM_ROUTE_SECRET=
# Optional: key that encrypts staff authenticator secrets (defaults to PLATFORM_ROUTE_SECRET).
# Set it separately so the route can be rotated without everyone re-linking their authenticator.
# PLATFORM_SECRET_KEY=
