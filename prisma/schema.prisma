  attachments          PointAttachment[]

  @@unique([firmId, id])
  @@unique([firmId, engagementId, pointSequence])
  @@unique([firmId, engagementId, pointNumber])
  @@index([firmId, engagementId, status, createdAt])
  @@index([firmId, assignedToUserId, status, dueDate])
  @@index([firmId, engagementId, blocking, workflowStageId])
  @@index([firmId, checklistItemId])
  @@map("engagement_points")
}

model PointResponse {
  id              String            @id @default(uuid()) @db.Uuid
  firmId          String            @map("firm_id") @db.Uuid
  pointId         String            @map("point_id") @db.Uuid
  point           EngagementPoint   @relation(fields: [firmId, pointId], references: [firmId, id])
  authorUserId    String            @map("author_user_id") @db.Uuid
  author          User              @relation(fields: [firmId, authorUserId], references: [firmId, id])
  parentCommentId String?           @map("parent_comment_id") @db.Uuid
  parent          PointResponse?    @relation("PointThread", fields: [firmId, pointId, parentCommentId], references: [firmId, pointId, id])
  replies         PointResponse[]   @relation("PointThread")
  commentText     String            @map("comment_text")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  attachments     PointAttachment[]

  @@unique([firmId, pointId, id])
  @@index([firmId, pointId, createdAt])
  @@map("point_responses")
}

model PointAttachment {
  id               String          @id @default(uuid()) @db.Uuid
  firmId           String          @map("firm_id") @db.Uuid
  pointId          String          @map("point_id") @db.Uuid
  point            EngagementPoint @relation(fields: [firmId, pointId], references: [firmId, id])
  responseId       String?         @map("response_id") @db.Uuid
  response         PointResponse?  @relation(fields: [firmId, pointId, responseId], references: [firmId, pointId, id])
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       User            @relation(fields: [firmId, uploadedByUserId], references: [firmId, id])
  fileName         String          @map("file_name")
  mediaType        String          @map("media_type")
  byteSize         Int             @map("byte_size")
  storageKey       String          @unique @map("storage_key")
  verifiedAt       DateTime?       @map("verified_at")
  removedAt        DateTime?       @map("removed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([firmId, pointId])
  @@map("point_attachments")
}

// Work dates are business dates. Only Submitted entries contribute to actuals.
enum TimeEntryStatus {
  Draft
  Submitted
}

model TimeEntry {
  id                        String                   @id @default(uuid()) @db.Uuid
  firmId                    String                   @map("firm_id") @db.Uuid
  firm                      Firm                     @relation(fields: [firmId], references: [id])
  userId                    String                   @map("user_id") @db.Uuid
  user                      User                     @relation("TimeEmployee", fields: [firmId, userId], references: [firmId, id])
  engagementId              String                   @map("engagement_id") @db.Uuid
  engagement                Engagement               @relation(fields: [firmId, engagementId], references: [firmId, id])
  engagementWorkflowId      String?                  @map("engagement_workflow_id") @db.Uuid
  workflow                  EngagementWorkflow?      @relation(fields: [firmId, engagementId, engagementWorkflowId], references: [firmId, engagementId, id])
  engagementWorkflowStageId String?                  @map("engagement_workflow_stage_id") @db.Uuid
  stage                     EngagementWorkflowStage? @relation(fields: [firmId, engagementWorkflowId, engagementWorkflowStageId], references: [firmId, engagementWorkflowId, id])
  checklistItemId           String?                  @map("checklist_item_id") @db.Uuid
  checklistItem             EngagementChecklistItem? @relation(fields: [firmId, checklistItemId], references: [firmId, id])
  workAllocationId          String?                  @map("work_allocation_id") @db.Uuid
  workAllocation            WorkAllocation?          @relation(fields: [firmId, workAllocationId], references: [firmId, id])
  workDate                  DateTime                 @map("work_date") @db.Date
  hours                     Decimal                  @db.Decimal(4, 2)
  description               String
  status                    TimeEntryStatus          @default(Draft)
  revision                  Int                      @default(1)
  requestId                 String                   @map("request_id") @db.Uuid
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  submittedAt               DateTime?                @map("submitted_at")
  createdByUserId           String                   @map("created_by_user_id") @db.Uuid
  createdBy                 User                     @relation("TimeCreator", fields: [firmId, createdByUserId], references: [firmId, id])
  updatedByUserId           String                   @map("updated_by_user_id") @db.Uuid
  updatedBy                 User                     @relation("TimeUpdater", fields: [firmId, updatedByUserId], references: [firmId, id])

  @@unique([firmId, id])
  @@unique([firmId, userId, requestId])
  @@index([firmId, userId, workDate])
  @@index([firmId, engagementId, status, workDate])
  @@map("time_entries")
}

model CapacityAdjustment {
  id              String    @id @default(uuid()) @db.Uuid
  firmId          String    @map("firm_id") @db.Uuid
  firm            Firm      @relation(fields: [firmId], references: [id])
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation("CapacityEmployee", fields: [firmId, userId], references: [firmId, id])
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  adjustmentType  String    @map("adjustment_type")
  hoursReduction  Decimal   @map("hours_reduction") @db.Decimal(4, 2)
  reason          String
  revision        Int       @default(1)
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdBy       User      @relation("CapacityCreator", fields: [firmId, createdByUserId], references: [firmId, id])
  updatedByUserId String    @map("updated_by_user_id") @db.Uuid
  updatedBy       User      @relation("CapacityUpdater", fields: [firmId, updatedByUserId], references: [firmId, id])

  @@unique([firmId, id])
  @@index([firmId, userId, startDate, endDate])
  @@map("capacity_adjustments")
}

// Setu staff who run the owner console. Not tenant users; created from the CLI.
model PlatformAdmin {
  id            String             @id @default(uuid()) @db.Uuid
  email         String             @unique
  name          String
  passwordHash  String?            @map("password_hash")
  totpSecretEnc String?            @map("totp_secret_enc")
  totpLastStep  Int?               @map("totp_last_step")
  failedLogins  Int                @default(0) @map("failed_logins")
  lockedUntil   DateTime?          @map("locked_until")
  invitedById   String?            @map("invited_by_id") @db.Uuid
  active        Boolean            @default(true)
  lastLoginAt   DateTime?          @map("last_login_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  sessions      PlatformSession[]
  issuedKeys    LicenseIssue[]
  auditLogs     PlatformAuditLog[]
  tokens        PlatformToken[]
  reminders     PlanReminder[]

  @@map("platform_admins")
}

model PlatformSession {
  id        String        @id @default(uuid()) @db.Uuid
  adminId   String        @map("admin_id") @db.Uuid
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("platform_sessions")
}

// Every key Setu issues, against the payment it was issued for.
model LicenseIssue {
  id         String         @id @default(uuid()) @db.Uuid
  keyId      String         @unique @map("key_id")
  orderRef   String         @unique @map("order_ref")
  kind       String
  days       Int
  seats      Int
  amount     Decimal?       @db.Decimal(12, 2)
  currency   String?
  note       String         @default("")
  firmId     String?        @map("firm_id") @db.Uuid
  firm       Firm?          @relation(fields: [firmId], references: [id])
  issuedById String?        @map("issued_by_id") @db.Uuid
  issuedBy   PlatformAdmin? @relation(fields: [issuedById], references: [id])
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([firmId])
  @@map("license_issues")
}

model PlatformAuditLog {
  id        String         @id @default(uuid()) @db.Uuid
  adminId   String?        @map("admin_id") @db.Uuid
  admin     PlatformAdmin? @relation(fields: [adminId], references: [id])
  action    String
  firmId    String?        @map("firm_id") @db.Uuid
  metadata  Json           @default("{}")
  ip        String?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([firmId])
  @@map("platform_audit_logs")
}

model PlatformToken {
  id            String        @id @default(uuid()) @db.Uuid
  adminId       String        @map("admin_id") @db.Uuid
  admin         PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  purpose       String
  tokenHash     String        @unique @map("token_hash")
  totpSecretEnc String?       @map("totp_secret_enc")
  expiresAt     DateTime      @map("expires_at")
  usedAt        DateTime?     @map("used_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("platform_tokens")
}

model PlanReminder {
  id            String         @id @default(uuid()) @db.Uuid
  firmId        String         @map("firm_id") @db.Uuid
  firm          Firm           @relation(fields: [firmId], references: [id])
  licenseEndsAt DateTime       @map("license_ends_at")
  daysBefore    Int            @map("days_before")
  kind          String
  sentTo        String         @map("sent_to")
  adminId       String?        @map("admin_id") @db.Uuid
  admin         PlatformAdmin? @relation(fields: [adminId], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([firmId, createdAt])
  @@index([createdAt])
  @@map("plan_reminders")
}
