  @@map("time_entries")
}

model CapacityAdjustment {
  id String @id @default(uuid()) @db.Uuid
  firmId String @db.Uuid @map("firm_id")
  firm Firm @relation(fields: [firmId], references: [id])
  userId String @db.Uuid @map("user_id")
  user User @relation("CapacityEmployee", fields: [firmId, userId], references: [firmId, id])
  startDate DateTime @db.Date @map("start_date")
  endDate DateTime @db.Date @map("end_date")
  adjustmentType String @map("adjustment_type")
  hoursReduction Decimal @db.Decimal(4,2) @map("hours_reduction")
  reason String
  revision Int @default(1)
  cancelledAt DateTime? @map("cancelled_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdByUserId String @db.Uuid @map("created_by_user_id")
  createdBy User @relation("CapacityCreator", fields: [firmId, createdByUserId], references: [firmId, id])
  updatedByUserId String @db.Uuid @map("updated_by_user_id")
  updatedBy User @relation("CapacityUpdater", fields: [firmId, updatedByUserId], references: [firmId, id])
  @@unique([firmId, id])
  @@index([firmId, userId, startDate, endDate])
  @@map("capacity_adjustments")
}
