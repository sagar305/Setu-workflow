enum AllocationStatus {
  Planned
  Assigned
  InProgress
  Blocked
  Completed
  Cancelled
}

model WorkAllocation {
  id String @id @default(uuid()) @db.Uuid
  firmId String @db.Uuid @map("firm_id")
  firm Firm @relation(fields: [firmId], references: [id])
  engagementId String @db.Uuid @map("engagement_id")
  engagement Engagement @relation(fields: [firmId, engagementId], references: [firmId, id])
  engagementWorkflowId String? @db.Uuid @map("engagement_workflow_id")
  workflow EngagementWorkflow? @relation(fields: [firmId, engagementId, engagementWorkflowId], references: [firmId, engagementId, id])
  engagementWorkflowStageId String? @db.Uuid @map("engagement_workflow_stage_id")
  stage EngagementWorkflowStage? @relation(fields: [firmId, engagementWorkflowId, engagementWorkflowStageId], references: [firmId, engagementWorkflowId, id])
  assignedUserId String @db.Uuid @map("assigned_user_id")
  assignedUser User @relation("AllocationEmployee", fields: [firmId, assignedUserId], references: [firmId, id])
  assignedByUserId String @db.Uuid @map("assigned_by_user_id")
  assignedBy User @relation("AllocationCreator", fields: [firmId, assignedByUserId], references: [firmId, id])
  allocationDate DateTime @db.Date @map("allocation_date")
  plannedStartAt DateTime? @map("planned_start_at")
  plannedEndAt DateTime? @map("planned_end_at")
  allocatedHours Decimal @db.Decimal(8, 2) @map("allocated_hours")
  status AllocationStatus @default(Assigned)
  priority EngagementPriority @default(Normal)
  description String @default("")
  allocationNote String @default("") @map("allocation_note")
  blockedReason String @default("") @map("blocked_reason")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cancelledAt DateTime? @map("cancelled_at")
  @@unique([firmId, id])
  @@index([firmId, engagementId, allocationDate])
  @@index([firmId, assignedUserId, allocationDate])
  @@index([firmId, allocationDate, status])
  @@index([firmId, status])
  @@index([firmId, engagementWorkflowStageId])
  @@map("work_allocations")
}
